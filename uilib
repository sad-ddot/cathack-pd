	local Toggle = { State = State; Flag = Config.Flag; Callback = Config.Callback };
	function Toggle:Set(On)
		State = On == true;
		self.State = State;
		local Info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
		Library:Tween(Pill, Info, { BackgroundColor3 = State and Library.Palette.AccentBg or Library.Palette.ControlBg }):Play();
		Library:Tween(Mark, Info, { BackgroundColor3 = State and Library.Palette.AccentMid or Library.Palette.Toggle }):Play();
		Library:Tween(Knob, Info, {
			BackgroundColor3 = State and Library.Palette.Accent or Library.Palette.Toggle;
			Position = State and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 18, 0.5, 0);
		}):Play();
		Library:Tween(Hole, Info, { BackgroundTransparency = State and 0 or 1 }):Play();
		Library:Tween(Label, Info, { TextColor3 = State and Library.Palette.Title or Library.Palette.Subtext }):Play();
		if Config.Flag then Library.Flags[Config.Flag] = State end;
		if typeof(Config.Callback) == "function" then Config.Callback(State) end;
	end;
	function Toggle:Get()
		return State;
