		Thickness = 3;
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border;
	});

	local Hit = self:CreateInstance("TextButton", {
		Name = "Hit";
		Parent = Track;
		AnchorPoint = Vector2.new(0.5, 0.5);
		Position = UDim2.new(0.5, 0, 0.5, 0);
		Size = UDim2.new(1, 16, 1, 16);
		BackgroundTransparency = 1;
		Text = "";
		AutoButtonColor = false;
		ZIndex = 5;
	});

	local Slider = { Value = Value; Flag = Config.Flag; Callback = Config.Callback };
	function Slider:Set(v)
		v = math.clamp(tonumber(v) or SliderMin, SliderMin, SliderMax);
		Value = v;
		self.Value = v;
		local pct = (v - SliderMin) / (SliderMax - SliderMin);
		local Info = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
		Library:Tween(Fill, Info, { Size = UDim2.new(pct, 0, 1, 0) }):Play();
		Library:Tween(Knob, Info, { Position = UDim2.new(pct, 0, 0.5, 0) }):Play();
		ValueLabel.Text = math.floor(v) .. "%";
		if Config.Flag then Library.Flags[Config.Flag] = v end;
		if typeof(Config.Callback) == "function" then Config.Callback(v) end;
	end;
	function Slider:Get()
		return Value;
	end;

	local Dragging = false;
	self:Connection(Hit.InputBegan, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = true;
			local rel = (Input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X;
			Slider:Set(SliderMin + math.clamp(rel, 0, 1) * (SliderMax - SliderMin));
		end;
	end);
	self:Connection(UserInputService.InputEnded, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = false;
		end;
	end);
	self:Connection(UserInputService.InputChanged, function(Input)
		if not Dragging then return end;
		if Input.UserInputType ~= Enum.UserInputType.MouseMovement and Input.UserInputType ~= Enum.UserInputType.Touch then return end;
		local rel = (Input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X;
