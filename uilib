		function SubTab:ApplySettings()
			local LocalUserName = (Players.LocalPlayer and Players.LocalPlayer.Name) or "cathack";
			local WinRef = Library.Open;

			local Appearance = self:AddSection("Appearance");
			local AnonAlias = Appearance:AddTextInput("Anonymous alias", "Anonymous", "shown when anonymous mode is on");
