		BorderSizePixel = 0;
		Visible = false;
		GroupTransparency = 1;
		ZIndex = 200;
	});
	self:CreateInstance("UICorner", { Parent = Popup; CornerRadius = UDim.new(0, 8); });
	self:CreateInstance("UIStroke", {
		Parent = Popup;
		Color = Library.Palette.Border;
		Thickness = 1;
	});
	local KeyRow = self:CreateInstance("TextButton", {
		Name = "KeyRow"; Parent = Popup;
		Position = UDim2.new(0, 8, 0, 8);
		Size = UDim2.new(1, -16, 0, 36);
		BackgroundColor3 = Library.Palette.ControlBg;
		BorderSizePixel = 0;
		AutoButtonColor = false;
		Text = "";
		ZIndex = 201;
	});
	self:CreateInstance("UICorner", { Parent = KeyRow; CornerRadius = UDim.new(0, 6); });
	local KeyText = self:CreateInstance("TextLabel", {
		Name = "KeyText"; Parent = KeyRow;
		AnchorPoint = Vector2.new(0, 0.5);
		Position = UDim2.new(0, 12, 0.5, 0);
		Size = UDim2.new(1, -20, 1, 0);
		BackgroundTransparency = 1;
		FontFace = Library.BodyFont;
		Text = "None";
		TextColor3 = Library.Palette.Title;
		TextSize = 14;
		TextXAlignment = Enum.TextXAlignment.Left;
		TextYAlignment = Enum.TextYAlignment.Center;
		ZIndex = 202;
	});

	local ModeRow = self:CreateInstance("Frame", {
		Name = "ModeRow"; Parent = Popup;
		AnchorPoint = Vector2.new(0, 1);
		Position = UDim2.new(0, 8, 1, -8);
		Size = UDim2.new(1, -16, 0, 32);
		BackgroundColor3 = Library.Palette.ControlBg;
		BorderSizePixel = 0;
		ZIndex = 201;
	});
	self:CreateInstance("UICorner", { Parent = ModeRow; CornerRadius = UDim.new(0, 6); });
	local ModeCount = #KeybindModes;
	local ModeSlider = self:CreateInstance("Frame", {
		Name = "Slider"; Parent = ModeRow;
		Position = UDim2.new(0, 0, 0, 0);
		Size = UDim2.new(1 / ModeCount, 0, 1, 0);
		BackgroundColor3 = Library.Palette.Accent;
		BorderSizePixel = 0;
		ZIndex = 202;
	});
	self:CreateInstance("UICorner", { Parent = ModeSlider; CornerRadius = UDim.new(0, 6); });
	local ModeButtons = {};
	for i, m in KeybindModes do
		local btn = self:CreateInstance("TextButton", {
			Name = "Mode_" .. m; Parent = ModeRow;
			AutoButtonColor = false;
			Text = m;
			FontFace = Library.BodyFont;
			TextSize = 13;
			TextColor3 = Library.Palette.Title;
			BackgroundTransparency = 1;
			BorderSizePixel = 0;
			Position = UDim2.new((i - 1) / ModeCount, 0, 0, 0);
			Size = UDim2.new(1 / ModeCount, 0, 1, 0);
			ZIndex = 203;
		});
		ModeButtons[i] = btn;
	end;

	local LibRef = self;
	local Listening = false;
	local function Render()
		KeyText.Text = Listening and "..." or KeyDisplayName(Key);
		local Info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
		Library:Tween(ModeSlider, Info, {
			Position = UDim2.new((ModeIdx - 1) / ModeCount, 0, 0, 0);
		}):Play();
		for i, btn in ModeButtons do
			btn.TextColor3 = (i == ModeIdx) and Library.Palette.Title or Library.Palette.Subtext;
		end;
	end;

	local KbObj = { Row = Row; Popup = Popup; Gear = Gear; };
	local ListId = tostring(KbObj);
	local Active = false;
	local function IsListActive()
		if Key == nil then return false end;
		if KeybindModes[ModeIdx] == "Always" then return true end;
		return Active == true;
	end;
	local function SyncList()
		if ListName then
			Library.KeybindList:Update(ListId, ListName, Key, IsListActive());
		end;
	end;
	local function FireActive(newActive)
		if Active == newActive then return end;
		Active = newActive;
		SyncList();
		Callback(Active);
	end;
	local function EvalMode()
		if KeybindModes[ModeIdx] == "Always" then
			FireActive(true);
		elseif KeybindModes[ModeIdx] == "Hold" and not Key then
			FireActive(false);
		end;
		SyncList();
	end;

	local SuppressClose = false;
	local function MarkInside(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			SuppressClose = true;
		end;
	end;
	LibRef:Connection(Popup.InputBegan, MarkInside);
	for i, btn in ModeButtons do
		LibRef:Connection(btn.InputBegan, MarkInside);
		LibRef:Connection(btn.MouseButton1Click, function()
			ModeIdx = i;
			Render();
			EvalMode();
		end);
	end;
	LibRef:Connection(KeyRow.InputBegan, MarkInside);
	LibRef:Connection(KeyRow.MouseButton1Click, function()
		Listening = true;
		Render();
	end);
	local PopupTargetY = 0;
	local PopupAnimToken = 0;
	local function OpenPopup()
		if not Gear.Parent then return end;
		PopupAnimToken = PopupAnimToken + 1;
		local ap = Gear.AbsolutePosition;
		local sz = Gear.AbsoluteSize;
		local x = ap.X + sz.X - 220;
		PopupTargetY = ap.Y + sz.Y + 61;
		Popup.Position = UDim2.new(0, x, 0, PopupTargetY - 8);
		Popup.GroupTransparency = 1;
		Popup.Visible = true;
		Render();
		local Info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
		Library:Tween(Popup, Info, {
			GroupTransparency = 0;
			Position = UDim2.new(0, x, 0, PopupTargetY);
		}):Play();
	end;
	local function ClosePopup()
		if not Popup.Visible then return end;
		PopupAnimToken = PopupAnimToken + 1;
		local token = PopupAnimToken;
		local Info = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In);
		Library:Tween(Popup, Info, {
			GroupTransparency = 1;
			Position = Popup.Position - UDim2.new(0, 0, 0, 8);
		}):Play();
		task.delay(0.16, function()
			if PopupAnimToken == token then
				Popup.Visible = false;
			end;
		end);
	end;
	LibRef:Connection(Gear.MouseButton1Click, function()
		if Popup.Visible then ClosePopup() else OpenPopup() end;
	end);
	LibRef:Connection(UserInputService.InputBegan, function(input, processed)
		if not Popup.Visible then return end;
		if Listening then return end;
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end;
		task.defer(function()
			if not Popup.Visible then return end;
			if SuppressClose then SuppressClose = false; return end;
			local ga = Gear.AbsolutePosition; local gs = Gear.AbsoluteSize;
			local m = UserInputService:GetMouseLocation();
			local onGear = m.X >= ga.X and m.X <= ga.X + gs.X and m.Y >= ga.Y and m.Y <= ga.Y + gs.Y;
			if onGear then return end;
			ClosePopup();
		end);
	end);
	LibRef:Connection(UserInputService.InputBegan, function(input, processed)
		if Listening then
			if processed then return end;
			local t = input.UserInputType;
			if t == Enum.UserInputType.Keyboard then
				if input.KeyCode == Enum.KeyCode.Escape then
					Key = nil;
				else
					Key = input.KeyCode;
				end;
			elseif t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
				Key = t;
			else
				return;
			end;
			Listening = false;
			Render();
			SyncList();
			return;
		end;
		if processed then return end;
		if not Key or KeybindModes[ModeIdx] == "Always" then return end;
		local pressed = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or input.UserInputType;
		if pressed == Key then
			if KeybindModes[ModeIdx] == "Toggle" then
				FireActive(not Active);
			elseif KeybindModes[ModeIdx] == "Hold" then
				FireActive(true);
			end;
		end;
	end);
	LibRef:Connection(UserInputService.InputEnded, function(input, processed)
		if processed then return end;
		if not Key or KeybindModes[ModeIdx] ~= "Hold" then return end;
		local pressed = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or input.UserInputType;
		if pressed == Key then
			FireActive(false);
		end;
	end);

	Render();
	if ListName then
		Library.KeybindList:Register(ListId, ListName, Key, IsListActive());
	end;
	if KeybindModes[ModeIdx] == "Always" then
		task.defer(function() FireActive(true) end);
	end;

	function KbObj:Get() return Key, KeybindModes[ModeIdx], Active end;
	function KbObj:Set(k, m)
		Key = k;
		if m then
			for i, mm in KeybindModes do
				if mm == m then ModeIdx = i; break end;
			end;
		end;
		Render();
		EvalMode();
		SyncList();
	end;
	return KbObj;
end;

