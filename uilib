	function Tab:SetActiveSubTab(SubTab)
		self.ActiveSubTab = SubTab;
		local FadeInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
		local NewPage = SubTab and SubTab.Page;
		for _, Pg in Win.Pages do
			if Pg ~= NewPage and Pg.Visible then
				local FadePg = Pg;
				Library:Tween(FadePg, FadeInfo, { GroupTransparency = 1 }):Play();
				task.delay(FadeInfo.Time, function()
					if FadePg and FadePg.Parent and FadePg.GroupTransparency >= 0.99 then
						FadePg.Visible = false;
					end;
				end);
			elseif Pg ~= NewPage then
				Pg.Visible = false;
				Pg.GroupTransparency = 1;
			end;
		end;
		for _, OtherTab in Win.AllTabs do
			for _, St in OtherTab.SubTabs do
				local target = (St == SubTab) and Library.Palette.Title or Library.Palette.Subtext;
				Library:Tween(St.Frame, FadeInfo, { TextColor3 = target }):Play();
			end;
			if OtherTab ~= self then OtherTab.ActiveSubTab = nil end;
		end;
		if NewPage then
			NewPage.GroupTransparency = 1;
			NewPage.Visible = true;
			Library:Tween(NewPage, FadeInfo, { GroupTransparency = 0 }):Play();
		end;
		if SubTab and SubTab.Callback then
			task.spawn(SubTab.Callback);
		end;
		if Win.Breadcrumb and SubTab then
			Win.Breadcrumb.Text = Library.Directory .. " > " .. self.Title .. " > " .. SubTab.Title;
