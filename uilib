			Color = Library.Palette.ControlBg;
			Thickness = 2;
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border;
		});
		return k;
	end;
	local LoKnob = MakeKnob((Lo - SliderMin) / (SliderMax - SliderMin));
	local HiKnob = MakeKnob((Hi - SliderMin) / (SliderMax - SliderMin));

	local Hit = self:CreateInstance("TextButton", {
		Name = "Hit";
		Parent = Track;
		AnchorPoint = Vector2.new(0.5, 0.5);
		Position = UDim2.new(0.5, 0, 0.5, 0);
		Size = UDim2.new(1, 16, 1, 16);
		BackgroundTransparency = 1;
		Text = "";
		AutoButtonColor = false;
		ZIndex = 5;
	});

	local Slider = { Lo = Lo, Hi = Hi; Flag = Config.Flag; Callback = Config.Callback };
	function Slider:Set(lo, hi)
		lo = math.clamp(tonumber(lo) or SliderMin, SliderMin, SliderMax);
		hi = math.clamp(tonumber(hi) or SliderMax, SliderMin, SliderMax);
		if lo > hi then lo, hi = hi, lo end;
		Lo, Hi = lo, hi;
		self.Lo, self.Hi = lo, hi;
		local pLo = (lo - SliderMin) / (SliderMax - SliderMin);
		local pHi = (hi - SliderMin) / (SliderMax - SliderMin);
		local Info = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
		Library:Tween(Fill, Info, { Position = UDim2.new(pLo, 0, 0, 0); Size = UDim2.new(pHi - pLo, 0, 1, 0) }):Play();
		Library:Tween(LoKnob, Info, { Position = UDim2.new(pLo, 0, 0.5, 0) }):Play();
		Library:Tween(HiKnob, Info, { Position = UDim2.new(pHi, 0, 0.5, 0) }):Play();
