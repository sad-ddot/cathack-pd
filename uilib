		Default = Default == true;
	});

	Toggle.Row = Row;
	Toggle.Label = Label;
	Toggle.Pill = Pill;
	function Toggle:AddKeybind(DefaultKey, DefaultMode, Cb)
		local UserCb = typeof(Cb) == "function" and Cb or function() end;
