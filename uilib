		});
	});

	local function MakeKnob(p)
		local k = self:CreateInstance("Frame", {
			Name = "Knob";
			Parent = Track;
			AnchorPoint = Vector2.new(0.5, 0.5);
			Position = UDim2.new(p, 0, 0.5, 0);
