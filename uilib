		local AnyActive = false;
		for _, T in Win.AllTabs do
			if T.ActiveSubTab then AnyActive = true; break end;
		end;
		if not AnyActive then
			self:SetActiveSubTab(SubTab);
		end;

		Library:_RebuildSubTabConnector(self);
		return SubTab;
	end;

	return Tab;
end;

