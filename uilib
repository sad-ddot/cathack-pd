	local ItemPrefixes = { "Toggle_", "Slider_", "Dropdown_", "Button_", "Label_", "Keybind_", "Colorpicker_" };
	local function StripItemPrefix(name)
		for _, p in ItemPrefixes do
			if name:sub(1, #p) == p then return name:sub(#p + 1) end;
		end;
		return nil;
	end;

	local function ApplySearch(Query)
		Query = (Query or ""):gsub("^%s+", ""):gsub("%s+$", ""):lower();
		local Empty = Query == "";
		for _, Pair in Window.ColumnPairs do
			for _, Col in Pair do
				for _, SectionFrame in Col:GetChildren() do
					if SectionFrame:IsA("Frame") and SectionFrame.Name:sub(1, 8) == "Section_" then
						local SectionTitle = SectionFrame.Name:sub(9):lower();
						local Content = SectionFrame:FindFirstChild("Content");
						if Content then
							local SectionMatchesQuery = (not Empty) and SectionTitle:find(Query, 1, true) ~= nil;
							local AnyVisible = false;
							for _, Item in Content:GetChildren() do
								local TitleText = StripItemPrefix(Item.Name);
								if TitleText then
									local Match = Empty
										or SectionMatchesQuery
										or TitleText:lower():find(Query, 1, true) ~= nil;
									Item.Visible = Match;
									if Match then AnyVisible = true end;
								elseif Item.Name == "Divider" then
									Item.Visible = Empty;
								end;
							end;
							SectionFrame.Visible = Empty or AnyVisible;
						end;
					end;
				end;
			end;
		end;
	end;

	self:Connection(SearchInput:GetPropertyChangedSignal("Text"), function()
		ApplySearch(SearchInput.Text);
	end);

	function Window:SetVisible(On)
		Gui.Enabled = On == true;
		Blur.Enabled = On == true;
	end;

	function Window:Toggle()
		self:SetVisible(not Gui.Enabled);
	end;

	function Window:Destroy()
		if Blur and Blur.Parent then Blur:Destroy() end;
		if Gui and Gui.Parent then Gui:Destroy() end;
		if Library.Open == self then
			Library.Open = nil;
		end;
	end;


	self.Open = Window;
	self:Log("Window created");
	return Window;
end;


