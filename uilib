			end;

			local ConfigIO = self:AddSection("Config");
			local function ListConfigs()
				local out = {};
				local files = (typeof(listfiles) == "function") and listfiles(Library.Directory .. "/Configs") or nil;
				if typeof(files) == "table" then
					for _, f in files do
						local leaf = tostring(f):gsub("\\", "/"):match("([^/]+)$") or "";
						if leaf:sub(-4):lower() == ".cfg" then
							table.insert(out, leaf:sub(1, -5));
						end;
					end;
				end;
				if #out == 0 then table.insert(out, "default") end;
				return out;
			end;
			local ConfigDrop = ConfigIO:AddDropdown("Active config", ListConfigs(), "default");
			local ConfigName = ConfigIO:AddTextInput("Config name", "default", "type a name...");
			ConfigIO:AddMultiButton({
