		Parent = Box;
		AnchorPoint = Vector2.new(1, 0.5);
		Position = UDim2.new(1, -12, 0.5, 0);
		Size = UDim2.new(0, 14, 0, 14);
		BackgroundTransparency = 1;
		Image = "rbxassetid://73146893967168";
		ImageColor3 = Library.Palette.Title;
	});

	local Dropdown = { Value = IsMulti and SelectedSet or Selected; Flag = Config.Flag; Callback = Config.Callback };
	function Dropdown:Set(v)
		if IsMulti then
			SelectedSet = {};
			if typeof(v) == "table" then
				for _, x in v do SelectedSet[x] = true end;
			elseif v ~= nil then
				SelectedSet[v] = true;
			end;
			self.Value = SelectedSet;
		else
			Selected = v;
			self.Value = v;
		end;
		ValueLabel.Text = GetDisplay();
		if Config.Flag then Library.Flags[Config.Flag] = self.Value end;
		if typeof(Config.Callback) == "function" then Config.Callback(self.Value) end;
	end;
	function Dropdown:Get()
		return IsMulti and SelectedSet or Selected;
	end;

	local Win = self.Open;
	local IsOpen = false;
	local PopupGui, Popup, Backdrop;

	local function ClosePopup()
		if not IsOpen then
			if PopupGui then PopupGui:Destroy() end;
			PopupGui, Backdrop, Popup = nil, nil, nil;
			return;
		end;
		IsOpen = false;
		Library._PopupOpen = math.max(0, (Library._PopupOpen or 0) - 1);
		Chevron.Image = "rbxassetid://73146893967168";
		local PopupRef = Popup;
		local GuiRef = PopupGui;
		PopupGui, Backdrop, Popup = nil, nil, nil;
		if PopupRef and GuiRef then
			local Info = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In);
			local cur = PopupRef.Position;
			Library:Tween(PopupRef, Info, {
				Position = UDim2.new(cur.X.Scale, cur.X.Offset, cur.Y.Scale, cur.Y.Offset - 12);
				BackgroundTransparency = 1;
			}):Play();
			task.delay(0.14, function()
				if GuiRef and GuiRef.Parent then GuiRef:Destroy() end;
			end);
		elseif GuiRef then
			GuiRef:Destroy();
		end;
	end;

	local function OpenPopup()
		if IsOpen or not Win then return end;
		IsOpen = true;
		Library._PopupOpen = (Library._PopupOpen or 0) + 1;
		Chevron.Image = "rbxassetid://103129505793218";

		PopupGui = self:CreateInstance("ScreenGui", {
			Name = "\0";
			Parent = gethui and gethui() or CoreGui;
			DisplayOrder = 1500;
			IgnoreGuiInset = true;
			ResetOnSpawn = false;
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
		});

		Backdrop = self:CreateInstance("TextButton", {
			Name = "DropdownBackdrop";
			Parent = PopupGui;
			BackgroundTransparency = 1;
			Size = UDim2.new(1, 0, 1, 0);
			Position = UDim2.new(0, 0, 0, 0);
			Text = "";
			AutoButtonColor = false;
			ZIndex = 1;
		});

		local RowH = 30;
		local PopupH = math.min(#Options * RowH + 8, 200);
		local TargetX = Box.AbsolutePosition.X;
		local TargetY = Box.AbsolutePosition.Y + Box.AbsoluteSize.Y + 65;
		Popup = self:CreateInstance("Frame", {
			Name = "DropdownPopup";
			Parent = PopupGui;
			Position = UDim2.new(0, TargetX, 0, TargetY - 12);
			Size = UDim2.new(0, Box.AbsoluteSize.X, 0, PopupH);
			BackgroundColor3 = Library.Palette.ControlBg;
			BackgroundTransparency = 1;
			BorderSizePixel = 0;
			ZIndex = 2;
			ClipsDescendants = true;
		});
		local Info = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
		self:Tween(Popup, Info, {
			Position = UDim2.new(0, TargetX, 0, TargetY);
			BackgroundTransparency = 0;
		}):Play();
		self:CreateInstance("UICorner", {
			Parent = Popup;
			CornerRadius = UDim.new(0, 8);
		});
		self:CreateInstance("UIPadding", {
			Parent = Popup;
			PaddingTop = UDim.new(0, 4);
			PaddingBottom = UDim.new(0, 4);
		});
		self:CreateInstance("UIListLayout", {
			Parent = Popup;
			SortOrder = Enum.SortOrder.LayoutOrder;
		});

		local OptionBtns = {};
		local function isActive(opt)
			if IsMulti then return SelectedSet[opt] == true end;
			return opt == Selected;
		end;
		local ColorTweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out);
		local function refreshBtnColors()
			for opt, btn in OptionBtns do
				local target = isActive(opt) and Library.Palette.Title or Library.Palette.Subtext;
				self:Tween(btn, ColorTweenInfo, { TextColor3 = target }):Play();
			end;
		end;
		for i, opt in Options do
			local Btn = self:CreateInstance("TextButton", {
				Name = "Option_" .. tostring(opt);
				Parent = Popup;
				Size = UDim2.new(1, 0, 0, RowH);
				BackgroundTransparency = 1;
				Text = tostring(opt);
				TextColor3 = isActive(opt) and Library.Palette.Title or Library.Palette.Subtext;
				TextSize = 14;
				FontFace = Library.BodyFont;
				TextXAlignment = Enum.TextXAlignment.Left;
				AutoButtonColor = false;
				ZIndex = 3;
				LayoutOrder = i;
			});
			self:CreateInstance("UIPadding", {
				Parent = Btn;
				PaddingLeft = UDim.new(0, 12);
			});
			OptionBtns[opt] = Btn;
			self:Connection(Btn.MouseButton1Click, function()
				if IsMulti then
					SelectedSet[opt] = not SelectedSet[opt] or nil;
					Dropdown.Value = SelectedSet;
					ValueLabel.Text = GetDisplay();
					refreshBtnColors();
				else
					Dropdown:Set(opt);
					ClosePopup();
				end;
			end);
		end;

		self:Connection(Backdrop.MouseButton1Click, ClosePopup);
	end;

	self:Connection(Box.MouseButton1Click, function()
		if IsOpen then ClosePopup() else OpenPopup() end;
	end);

	self:_RegisterControl(DropTitle, {
		Get = function()
			if IsMulti then
				local out = {};
				for _, opt in Options do
					if SelectedSet[opt] then table.insert(out, opt) end;
				end;
				return out;
			end;
			return Selected;
		end;
		Set = function(v) Dropdown:Set(v) end;
		Default = IsMulti and (typeof(Default) == "table" and Default or { Default }) or Default;
	});

	return Dropdown;
end;

