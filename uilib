	end;
	local Fill = self:CreateInstance("Frame", {
		Name = "Fill";
		Parent = Track;
		Position = UDim2.new((Lo - SliderMin) / (SliderMax - SliderMin), 0, 0, 0);
		Size = UDim2.new((Hi - Lo) / (SliderMax - SliderMin), 0, 1, 0);
