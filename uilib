						Library.EspPreviewState:SetVisible(true);
					end;
				else
					if Library.EspPreviewState and Library.EspPreviewState.SetVisible then
						Library.EspPreviewState:SetVisible(false);
					end;
				end;
			end;
			local HideAvatarToggle = Appearance:AddToggle("Hide avatar", false);
			local _HideAvOrigSet = HideAvatarToggle.Set;
			function HideAvatarToggle:Set(On)
				_HideAvOrigSet(self, On);
				if WinRef and WinRef.UserAvatar then
					local hide = self:Get();
					WinRef.UserAvatar.Visible = not hide;
					local nameOffset = hide and 0 or -44;
					if WinRef.UserNameLabel then
