function Library:_RegisterControl(Name, Wrap)
	if typeof(Name) ~= "string" or Name == "" then return end;
	self.Registry[Name] = Wrap;
end;

function Library:GetConfig()
	local out = {};
	for k, e in self.Registry do
		if e and typeof(e.Get) == "function" then
			local ok, v = pcall(e.Get);
			if ok then out[k] = v end;
		end;
	end;
	return HttpService:JSONEncode(out);
end;

function Library:LoadConfig(Json)
	local ok, data = pcall(HttpService.JSONDecode, HttpService, Json);
	if not ok or typeof(data) ~= "table" then return end;
	for k, v in data do
		local e = self.Registry[k];
		if e and typeof(e.Set) == "function" then
			pcall(e.Set, v);
		end;
	end;
end;

function Library:ResetConfig()
	for _, e in self.Registry do
		if e and typeof(e.Set) == "function" and e.Default ~= nil then
			pcall(e.Set, e.Default);
		end;
	end;
end;


function Library:IsEffectivelyVisible(Inst)
	local cur = Inst;
	while cur do
		if cur:IsA("ScreenGui") then return cur.Enabled end;
		if cur:IsA("GuiObject") and not cur.Visible then return false end;
		cur = cur.Parent;
	end;
	return false;
end;

